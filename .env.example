# Database
DATABASE_URL="postgresql://user:password@localhost:5432/package_tracker"

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID="123456789"

# Server port (defaults to 3000)
PORT=8777

# Simple web sign-in (defaults are admin / pass)
PACKAGE_TRACKER_USERNAME="admin"
PACKAGE_TRACKER_PASSWORD="pass"
PACKAGE_TRACKER_SESSION_SECRET="change-this-to-a-long-random-value"

# Check interval in minutes (defaults to 15)
CHECK_INTERVAL_MINUTES="15"

# Set true if you want a tracking check immediately when the app starts.
RUN_INITIAL_TRACKING_CHECK="false"

# FedEx headless is server-safe but may be blocked by FedEx/Akamai.
# Use "headful" only locally or under a virtual display such as Xvfb.
FEDEX_BROWSER_MODE="headless"
FEDEX_HEADFUL_FALLBACK="false"

# UPS works best with an installed Chrome browser. Leave blank to auto-detect.
UPS_CHROME_PATH=""
UPS_BROWSER_MODE="headless"
UPS_BROWSER_USER_DATA_DIR=""
